{
  "manifest_version": 3,
  "name": "OmniVoice Web Reader",
  "version": "0.6.0",
  "description": "Extract web page text and read it with OmniVoice Local Reader.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OmniVoice Web Reader",
    "default_popup": "popup.html"
  }
}